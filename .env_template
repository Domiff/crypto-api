# App
# true: local SQLite (db.sqlite3) and Redis on localhost; false: PostgreSQL and Redis at "redis"
IS_DEBUG=true
APP_TITLE=CryptoAPI
APP_VERSION=1

# PostgreSQL (used when IS_DEBUG=false; host is "pg" in Docker Compose)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=pg
POSTGRES_PORT=5432

# Deribit API base URL (trailing slash is required)
URL=https://www.deribit.com/api/v2/public/
# How often prices are fetched, seconds
INTERVAL=60

# Redis (host is chosen automatically by IS_DEBUG)
REDIS_PORT=6379
REDIS_DB=0
CONNECTION_POOL_MAXSIZE=10
EXPIRE=3600

# taskiq retries: attempts and delay between them, seconds
TASKIQ_RETRY_COUNT=5
TASKIQ_RETRY_DELAY=10
